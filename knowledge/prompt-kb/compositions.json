        "和谐",
        "经典"
      ],
      "recommended_for": [
        "风景",
        "人物",
        "建筑"
      ],
      "example_positions": [
        "眼睛",
        "主体",
        ""
      ],
      "notes": "最经典的构图法则，百搭且稳定"
    },
    {
