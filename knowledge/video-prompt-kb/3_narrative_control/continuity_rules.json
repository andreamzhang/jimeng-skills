{
  "category": "continuity_rules",
  "version": "1.0",
  "description": "连续性规则库，确保镜头间的视觉和逻辑一致性",
  "entries": [
    {
      "rule_type": "视线匹配",
      "alias": [
        "",
        "动作匹配"
      ],
      "description": "角色看向的方向在反打镜头中保持一致",
      "principle": "角色看向右，角色应该从左边入画",
      "examples": [
        {
          "scenario": "两人对话",
          "setup": "在画面左侧看向右侧的",
          "reverse": "在画面右侧看向左侧的",
          "error_to_avoid": "看右但在左边，或眼神不匹配"
        },
        {
          "scenario": "三人对话",
          "setup": "看→看→看形成三角形视线",
          "error_to_avoid": "视线方向混乱或循环不自然"
        }
      ],
      "prompt_templates": {
        "forward": "角色{方向}角色,眼睛",
        "reverse": "角色{方向},"
      },
      "directions": {
        "left": {
          "subject_view": "",
          "reverse_view": ""
        },
        "right": {
          "subject_view": "",
          "reverse_view": ""
        },
        "up": {
          "subject_view": "",
          "reverse_view": ""
        },
        "down": {
          "subject_view": "",
          "reverse_view": ""
        }
      }
    },
    {
      "rule_type": "视线匹配",
      "alias": [
        ""
      ],
      "description": "角色视线方向与看到的物体/人物位置一致",
      "principle": "如果角色向左看，下一个镜头应该显示左边的内容",
      "examples": [
        {
          "scenario": "角色看向窗外",
          "setup": "角色在窗边，面朝窗外",
          "POV": "窗外看到的内容，角度与角色视线一致"
        },
        {
          "scenario": "角色看手机",
          "setup": "角色低头看手机",
          "POV": "手机屏幕内容，从上方或正面拍摄"
        }
      ],
      "prompt_templates": {
        "subject": "角色,眼睛{/}",
        "POV": "主观视角的{道具},{方向}角色"
      }
    },
    {
      "rule_type": "动作连续性",
      "alias": [
        "的"
      ],
      "description": "动作在剪辑点前后保持连续和流畅",
      "principle": "动作跨越剪辑点时，起始和结束位置必须匹配",
      "examples": [
        {
          "scenario": "敲门动作",
          "setup_shot": "手抬起准备敲门",
          "cut_point": "剪辑点在手最高点",
          "continue_shot": "手落下敲门，手的位置与上一镜头一致"
        },
        {
          "scenario": "行走穿越",
          "setup_shot": "角色从画面右侧走入",
          "cut_point": "角色刚好完全入画",
          "continue_shot": "角色继续向左走去，位置与上一镜头衔接"
        },
        {
          "scenario": "坐下",
          "setup_shot": "人物站姿，准备坐下",
          "cut_point": "臀部接触椅面",
          "continue_shot": "坐下的完整动作，双脚位置保持一致"
        }
      ],
      "common_actions": [
        {
          "action": "推门",
          "key_point": "手接触门把手"
        },
        {
          "action": "倒水",
          "key_point": "壶嘴接触杯子"
        },
        {
          "action": "拥抱",
          "key_point": "手臂接触对方背部"
        },
        {
          "action": "握手",
          "key_point": "手接触"
        },
        {
          "action": "开枪",
          "key_point": "枪响瞬间"
        }
      ],
      "error_to_avoid": [
        "动作在剪辑点前后不一致",
        "位置跳跃（如从画面左边跳到中间）",
        "时间不连续（如杯子水位突然变化）"
      ]
    },
    {
      "rule_type": "服装/道具连续性",
      "alias": [
        "/"
      ],
      "description": "确保同一场景中服装、道具状态一致",
      "principle": "同一场景内，人物服装、配饰、携带道具不能突然变化",
      "examples": [
        {
          "scenario": "衬衫扣子",
          "rule": "如果特写镜头扣子敞开，全景时也应该敞开",
          "prompt": ""
        },
        {
          "scenario": "伤口",
          "rule": "伤口的状态（大小、渗血）在连续镜头中保持一致",
          "prompt": ","
        },
        {
          "scenario": "手持物品",
          "rule": "物品在手中的位置和状态保持一致",
          "prompt": ","
        }
      ],
      "checklist": [
        "服装完整度",
        "首饰/配饰",
        "发型",
        "妆容（特别是伤痕、口红）",
        "手持道具位置",
        "口袋物品"
      ]
    },
    {
      "rule_type": "光线连续性",
      "alias": [
        "光线"
      ],
      "description": "同一场景中光线方向和强度保持一致",
      "principle": "除非场景内有光源变化，否则光影应该一致",
      "examples": [
        {
          "scenario": "窗外光源",
          "rule": "如果从窗外看有阳光，下一个镜头（室内）也应该有对应的逆光或侧光",
          "prompt": "窗光和"
        },
        {
          "scenario": "人工光源",
          "rule": "台灯开启时，所有镜头中灯都应该亮着",
          "prompt": "(/),"
        }
      ],
      "lighting_elements": [
        "光源方向",
        "光强度",
        "阴影位置",
        "色温",
        "高光位置"
      ]
    },
    {
      "rule_type": "声音连续性",
      "alias": [
        ""
      ],
      "description": "声音在剪辑点保持连续或自然过渡",
      "principle": "对话、环境音在剪辑时应该有连续性或自然的断点",
      "examples": [
        {
          "scenario": "对话剪辑",
          "rule": "声音不应该在角色说话中间切断，应该完整保留一句话",
          "prompt": "-,"
        },
        {
          "scenario": "环境音",
          "rule": "持续的环境音（如雨声、交通）应该跨剪辑持续",
          "prompt": ""
        },
        {
          "scenario": "-",
          "rule": "下一个镜头的声音提前切入",
          "prompt": ""
        },
        {
          "scenario": "-",
          "rule": "上一个镜头的声音延续到下一个镜头",
          "prompt": ""
        }
      ]
    },
    {
      "rule_type": "空间连续性",
      "alias": [
        ""
      ],
      "description": "角色在场景中的位置和移动路径保持一致",
      "principle": "角色移动的方向、路径、速度在连续镜头中应该合理",
      "examples": [
        {
          "scenario": "走出房间",
          "setup": "角色在房间右侧走向左边的门",
          "continue": "下一个镜头从门外看，角色应该从左向右走出",
          "prompt": "角色"
        },
        {
          "scenario": "追逐",
          "setup": "追逐者从画面右侧进入",
          "continue": "被追逐者应该从画面左侧出现或已经在前方",
          "prompt": "和"
        }
      ],
      "spatial_checks": [
        "入口/出口位置",
        "人物相对位置",
        "移动方向",
        "距离变化"
      ]
    },
    {
      "rule_type": "时间连续性",
      "alias": [
        ""
      ],
      "description": "同一场景中时间流逝应该一致和合理",
      "principle": "除非明确表现时间跳跃，否则时间应该是连续的",
      "examples": [
        {
          "scenario": "阳光变化",
          "rule": "如果太阳在窗外位置固定，就不应该突然从左边变到右边",
          "prompt": "或"
        },
        {
          "scenario": "影子移动",
          "rule": "如果使用自然光，影子位置应该随时间合理变化",
          "prompt": "阴影"
        }
      ],
      "time_markers": [
        "钟表时间",
        "窗外光线/影子",
        "演员状态（汗水、疲惫）",
        "食物/饮料消耗"
      ]
    }
  ],
  "连续性检查清单": [
    "视线方向是否匹配",
    "动作在剪辑点是否连续",
    "服装/道具状态是否一致",
    "光线方向和强度是否匹配",
    "声音是否自然过渡",
    "空间位置是否合理",
    "时间线索是否一致"
  ],
  "AI视频特别注意事项": [
    "生成的镜头间容易出现不连续",
    "特别注意视线方向和动作的衔接",
    "建议使用固定的摄像机角度拍摄连续动作",
    "多拍几次直到连续性正确"
  ]
}