  "usage_guidelines": {
    "when_to_use": [
      "关键台词/信息揭示后需要呈现角色情绪变化",
      "对话戏中展示听者反应，强化正反打的情绪节奏",
      "需要观众情感指引或节奏缓冲时",
      "悬念场景可先给反应再揭示刺激源"
    ],
    "when_to_skip": [
      "需要刻意保持神秘或冷静的角色动机",
      "反应会削弱节奏或泄露信息时",
      "同一动作后已连续出现多次重复反应"
    ],
    "placement_rules": [
      "放在关键刺激源镜头之后 0-1 镜内",
      "冲突或转折点后必须出现至少一条微反应镜头",
      "反应镜头以特写/大特写/中近景为主，必要时使用过肩"
    ],
    "dialogue_rules": [
      "优先无台词，若必须台词应为短句",
      "反应镜头需体现微表情或余波动作"
    ]
  },
